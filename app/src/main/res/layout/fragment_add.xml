<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".NewNoteFragment"
        android:background="@color/lightgrey"
        >

        <View
            android:id="@+id/appbar"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:background="@color/white"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/save"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintEnd_toEndOf="@id/appbar"
            app:layout_constraintTop_toTopOf="@id/appbar"
            app:layout_constraintBottom_toBottomOf="@id/appbar"
            android:src="@drawable/outline_check_24"
            android:backgroundTint="@color/black"
            android:layout_marginRight="10dp"

            />
        <TextView
            android:id="@+id/addNoteHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/appbar"
            app:layout_constraintStart_toStartOf="@id/appbar"
            app:layout_constraintBottom_toBottomOf="@id/appbar"
            android:text="Add Note"
            android:textStyle="bold"
            android:layout_marginHorizontal="12dp"
            android:textColor="@color/black"
            android:textSize="24sp" />

        <EditText
            android:id="@+id/addNoteTitle"
            android:layout_width="match_parent"
            android:backgroundTint="@color/white"
            android:layout_height="60dp"
            android:hint="Enter the title"
            android:padding="12dp"
            android:layout_marginHorizontal="12dp"
            android:textSize="20sp"
            app:layout_constraintTop_toBottomOf="@id/appbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/addNoteDesc"
            android:background="@drawable/crylindrical_bg"
            android:layout_marginTop="16dp"
            android:maxLines="1"
            />

        <EditText
            android:id="@+id/addNoteDesc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_below="@id/addNoteTitle"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="12dp"
            android:gravity="top"
            android:backgroundTint="@color/white"
            android:hint="Enter the description"
            android:padding="12dp"
            android:background="@drawable/crylindrical_bg"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/addNoteTitle"
            app:layout_constraintStart_toStartOf="@id/addNoteHeading"
            app:layout_constraintEnd_toEndOf="@id/addNoteHeading"
            tools:layout_editor_absoluteX="12dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>