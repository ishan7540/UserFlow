<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context=".EditFragment"
        android:background="@color/lightgrey"
        >

        <View
            android:id="@+id/appbar"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:background="@color/white"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/editNoteHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/appbar"
            app:layout_constraintStart_toStartOf="@id/appbar"
            app:layout_constraintBottom_toBottomOf="@id/appbar"
            android:text="Ask me anything"
            android:textStyle="bold"
            android:layout_marginHorizontal="12dp"
            android:textColor="@color/black"
            android:textSize="24sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/appbar"
            app:layout_constraintBottom_toTopOf="@id/question"
            android:layout_marginBottom="20dp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            />
        <EditText
            android:id="@+id/question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/crylindrical_bg"
            android:gravity="top"
            android:hint="Ask your question"
            android:layout_marginBottom="20dp"
            android:maxHeight="100dp"
            android:padding="12dp"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="@id/editNoteHeading"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/editNoteHeading"
            app:layout_constraintEnd_toStartOf="@id/send"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView
            android:id="@+id/send"
            android:layout_width="30dp"
            android:layout_marginRight="10dp"
            android:layout_height="30dp"
            app:layout_constraintStart_toEndOf="@id/question"
            app:layout_constraintTop_toTopOf="@id/question"
            app:layout_constraintBottom_toBottomOf="@id/question"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/outline_arrow_forward_24"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>